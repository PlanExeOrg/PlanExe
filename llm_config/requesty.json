{
    "requesty-openai-gpt-4o-mini": {
        "comment": "OpenAI GPT-4o-mini routed through Requesty (https://requesty.ai), an OpenAI-compatible LLM gateway. Cheap and reliable starting point, similar to the OpenRouter defaults. Requires REQUESTY_API_KEY in the .env file. Uses OpenAILike pointed at the Requesty base_url; models use the provider/model naming convention.",
        "priority": 0,
        "luigi_workers": 4,
        "class": "OpenAILike",
        "arguments": {
            "model": "openai/gpt-4o-mini",
            "api_base": "https://router.requesty.ai/v1",
            "api_key": "${REQUESTY_API_KEY}",
            "temperature": 0.2,
            "timeout": 120.0,
            "is_function_calling_model": false,
            "is_chat_model": true,
            "context_window": 128000,
            "max_tokens": 16384,
            "max_retries": 5
        },
        "model_info_url": "https://app.requesty.ai/router/list",
        "pricing": {
            "input_per_million_tokens": 0.15,
            "output_per_million_tokens": 0.60
        },
        "pricing_kind": "paid"
    },
    "requesty-gemini-2.5-flash": {
        "comment": "Google Gemini 2.5 Flash routed through Requesty. Fast and cheap. Requires REQUESTY_API_KEY in the .env file.",
        "priority": 1,
        "luigi_workers": 4,
        "class": "OpenAILike",
        "arguments": {
            "model": "google/gemini-2.5-flash",
            "api_base": "https://router.requesty.ai/v1",
            "api_key": "${REQUESTY_API_KEY}",
            "temperature": 0.2,
            "timeout": 120.0,
            "is_function_calling_model": false,
            "is_chat_model": true,
            "context_window": 1000000,
            "max_tokens": 16384,
            "max_retries": 5
        },
        "model_info_url": "https://app.requesty.ai/router/list",
        "pricing": {
            "input_per_million_tokens": 0.30,
            "output_per_million_tokens": 2.50
        },
        "pricing_kind": "paid"
    }
}
